# Staging VPS deployment target. Real values live in .env.vps (never committed).
VPS_IP=203.0.113.10
VPS_USER=deploy
VPS_PASSWORD=

# Any Code cloud API (Phase 9). Unset in local-only mode.
ANYCODE_API_URL=http://localhost:8080
DATABASE_URL=postgres://anycode:anycode@localhost:5432/anycode
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# Identity provider (ZITADEL). Native clients are public OAuth clients — no client secret.
ANYCODE_OIDC_ISSUER=https://id.example.com
ANYCODE_OIDC_CLIENT_ID=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
RUST_LOG=info
